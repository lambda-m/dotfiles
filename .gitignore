.DS_Store
*~

# ~/.local/{bin,share,state} are shared with installers (Claude Code, pipx, ...).
# If stow ever folds ~/.local into a symlink, their files land here. Never track them.
shell/.local/share/
shell/.local/state/
shell/.local/bin/claude

# Emacs keeps all state (elpa, eln-cache, custom.el, ...) in ~/.local/state/emacs,
# see emacs/.config/emacs/init.el. Nothing under emacs/ should ever be generated.
