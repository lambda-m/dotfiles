# Brewfile.maxbookpro - the workhorse. This machine gets the superset.
#
#   brew bundle install --file=brew/Brewfile.maxbookpro
#
# Or set it once in ~/.profile.local and drop --file entirely:
#   export HOMEBREW_BUNDLE_FILE="$HOME/dotfiles/brew/Brewfile.maxbookpro"

dir  = File.expand_path(File.dirname(__FILE__))
path = "#{dir}/Brewfile.common"
instance_eval(File.read(path), path)

