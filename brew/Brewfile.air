# Brewfile.air - common plus whatever this machine actually needs.
#
#   brew bundle install --file=brew/Brewfile.air
#
# Deliberately thin. Fill it during the survey on that machine:
#   brew bundle cleanup --file=brew/Brewfile.air      # dry run: what is here but unlisted
#   brew bundle check   --file=brew/Brewfile.air -v   # what is listed but missing
# then promote the keepers with
#   brew bundle add --cask X --file=brew/Brewfile.air       (this machine only)
#   brew bundle add --cask X --file=brew/Brewfile.common   (all machines)

dir  = File.expand_path(File.dirname(__FILE__))
path = "#{dir}/Brewfile.common"
instance_eval(File.read(path), path)

# ---------- casks: this machine only ----------
