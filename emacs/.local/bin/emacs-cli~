#!/bin/sh

# Find the real emacs binary regardless of OS
EMACS_BIN=$(command -v emacs)

# If we are on macOS and the Homebrew version exists, prioritize it
if [ -x "/opt/homebrew/bin/emacs" ]; then
    EMACS_BIN="/opt/homebrew/bin/emacs"
fi

# Execute with terminal mode forced
exec "$EMACS_BIN" -nw "$@"